# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration ────────────────────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter Integration ────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# ── OpenAI-compatible eval ───────────────────────────────────────────────────
# OPENAI_API_KEY=your_provider_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Other AI integrations ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Private Render deployment ─────────────────────────────────────────────────
# Required when CAREER_OPS_WEB_REQUIRE_AUTH=true. Never commit real values.
# CAREER_OPS_WEB_BASIC_AUTH=your-username:long-random-password
# CAREER_OPS_WEB_ALLOWED_HOSTS=your-service.onrender.com
# CAREER_OPS_WEB_REQUIRE_AUTH=true

# ── Sources page: Indeed via your Apify actor ─────────────────────────────────
# APIFY_TOKEN=apify_api_paste-your-token-here
# INDEED_APIFY_ACTOR=owner/indeed-scraper

# ── Sources page: Firecrawl employer-career-site search ───────────────────────
# FIRECRAWL_API_KEY=fc-your-key-here

# ── Optional plugins ─────────────────────────────────────────────────────────
# NOTION_ACCESS_TOKEN=ntn_paste-your-internal-integration-secret
# NOTION_PARENT_PAGE_ID=your-notion-parent-page-id
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token
